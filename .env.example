# Required secrets. Generate SESSION_SIGNING_SECRET as 32 or more random
# characters; never commit a real .env file.
SERVER_PASSWORD=replace-with-shared-friends-password
ADMIN_PASSWORD=replace-with-separate-admin-password
SESSION_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Optional. Comma-separated addresses or CIDR ranges of reverse proxies whose
# X-Forwarded-For names the client; login attempts are counted per client.
# Unset, every request is keyed by its socket peer.
TRUSTED_PROXIES=
